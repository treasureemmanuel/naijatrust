/* ================================
   LOGIN
================================ */

function login(){

    const username =
        document.getElementById("loginUsername").value.trim();

    const password =
        document.getElementById("loginPassword").value.trim();

    if(!username || !password){

        showNotification("Enter your username and password.");

        return;
    }

    document.getElementById("loginScreen")
        .classList.add("hidden");

    document.getElementById("app")
        .classList.remove("hidden");

    renderTransactions();

    showNotification("Welcome back, Treasure.");

}


/* ================================
   LOGOUT
================================ */

function logout(){

    document.getElementById("app")
        .classList.add("hidden");

    document.getElementById("loginScreen")
        .classList.remove("hidden");

    document.getElementById("loginUsername").value = "";
    document.getElementById("loginPassword").value = "";

}


/* ================================
   PAGE NAVIGATION
================================ */

function openPage(pageId){

    const pages = [

        "homePage",
        "transferPage",
        "depositPage",
        "withdrawPage",
        "transactionsPage",
        "profilePage",
        "receiptPage"

    ];

    pages.forEach(id => {

        document.getElementById(id)
            .classList.add("hidden");

    });

    document.getElementById(pageId)
        .classList.remove("hidden");


    document.querySelectorAll(".nav-btn")
        .forEach(btn => btn.classList.remove("active"));


    if(pageId === "homePage"){
        document.getElementById("navHome").classList.add("active");
    }

    if(pageId === "transactionsPage"){
        document.getElementById("navHistory").classList.add("active");
    }

    if(pageId === "transferPage"){
        document.getElementById("navTransfer").classList.add("active");
    }

    if(pageId === "profilePage"){
        document.getElementById("navProfile").classList.add("active");
    }

}


/* ================================
   BALANCE
================================ */

let balanceHidden = false;

function toggleBalance(){

    balanceHidden = !balanceHidden;

    const value =
        document.getElementById("balanceValue");

    const button =
        document.querySelector(".eye-btn");

    if(balanceHidden){

        value.textContent = "₦••••••••";
        button.textContent = "Show";

    }else{

        value.textContent = formatMoney(balance);
        button.textContent = "Hide";

    }

}


/* ================================
   ACCOUNT NAME LOOKUP
================================ */

function lookupAccount(){

    const input =
        document.getElementById("accountNumber");

    const number =
        input.value.replace(/\D/g,"").slice(0,10);

    input.value = number;

    const box =
        document.getElementById("accountNameBox");

    const name =
        document.getElementById("accountName");

    const status =
        document.getElementById("verifyStatus");


    box.classList.add("hidden");

    if(number.length === 0){
        return;
    }

    if(number.length < 10){

        return;
    }


    /*
       LOCAL TEST ACCOUNT VERIFICATION

       This does NOT query real banks.

       1234567890 = Treasure Emmanuel
       Other listed numbers = test accounts.
    */


    let accountName = null;


    if(number === myTestAccount.number){

        accountName = myTestAccount.name;

    }else if(testAccounts[number]){

        accountName = testAccounts[number];

    }


    if(accountName){

        name.textContent = accountName;

        status.textContent =
            "Test account verified";

        status.style.color =
            "#00a86b";

        box.classList.remove("hidden");

    }else{

        name.textContent =
            "No local test account record found.";

        status.textContent =
            "Use one of the built-in test account numbers.";

        status.style.color =
            "#e5484d";

        box.classList.remove("hidden");

    }

}


/* ================================
   BANK SEARCH
================================ */

function searchBanks(){

    const input =
        document.getElementById("bankInput");

    const results =
        document.getElementById("bankResults");

    const search =
        input.value.toLowerCase().trim();


    results.innerHTML = "";


    if(!search){

        results.classList.add("hidden");

        return;
    }


    const filtered =
        banks.filter(bank =>
            bank.toLowerCase().includes(search)
        );


    if(filtered.length === 0){

        results.innerHTML =
            `<div class="bank-item">No bank found</div>`;

    }else{

        filtered.forEach(bank => {

            const item =
                document.createElement("div");

            item.className = "bank-item";

            item.textContent = bank;

            item.onclick = function(){

                selectBank(bank);

            };

            results.appendChild(item);

        });

    }


    results.classList.remove("hidden");

}


/* ================================
   SELECT BANK
================================ */

function selectBank(bank){

    selectedBank = bank;

    document.getElementById("bankInput").value = bank;

    document.getElementById("bankResults")
        .classList.add("hidden");

    const selected =
        document.getElementById("selectedBank");

    selected.textContent =
        "Selected Bank: " + bank;

    selected.classList.remove("hidden");

}


/* ================================
   TRANSFER
================================ */

function makeTransfer(){

    const accountNumber =
        document.getElementById("accountNumber")
            .value.trim();

    const amount =
        Number(
            document.getElementById("transferAmount")
                .value
        );

    const narration =
        document.getElementById("narration")
            .value.trim();

    const accountName =
        document.getElementById("accountName")
            .textContent.trim();


    if(!selectedBank){

        showNotification("Select a bank first.");

        return;
    }


    if(accountNumber.length !== 10){

        showNotification(
            "Enter a 10-digit account number."
        );

        return;
    }


    if(
        !accountName ||
        accountName.includes("No local")
    ){

        showNotification(
            "Verify a local test account first."
        );

        return;
    }


    if(!amount || amount <= 0){

        showNotification(
            "Enter a valid amount."
        );

        return;
    }


    if(amount > balance){

        showNotification(
            "Insufficient local balance."
        );

        return;
    }


    balance -= amount;


    transactions.unshift({

        title:"Transfer to " + accountName,

        amount:-amount,

        type:"debit",

        date:"Just now"

    });


    updateBalance();

    renderTransactions();


    const reference =
        "NTF" +
        Math.floor(
            1000000000 +
            Math.random() * 9000000000
        );


    document.getElementById("receiptAmount")
        .textContent = formatMoney(amount);

    document.getElementById("receiptName")
        .textContent = accountName;

    document.getElementById("receiptBank")
        .textContent = selectedBank;

    document.getElementById("receiptAccount")
        .textContent = "•••• " +
            accountNumber.slice(-4);

    document.getElementById("receiptReference")
        .textContent = reference;


    openPage("receiptPage");


    showNotification(
        "Local transfer recorded successfully."
    );

}


/* ================================
   DEPOSIT
================================ */

function depositMoney(){

    const amount =
        Number(
            document.getElementById("depositAmount")
                .value
        );


    if(!amount || amount <= 0){

        showNotification(
            "Enter a valid amount."
        );

        return;
    }


    balance += amount;


    transactions.unshift({

        title:"Cash Deposit",

        amount:amount,

        type:"credit",

        date:"Just now"

    });


    document.getElementById("depositAmount")
        .value = "";


    updateBalance();

    renderTransactions();

    openPage("homePage");

    showNotification(
        formatMoney(amount) +
        " added to local balance."
    );

}


/* ================================
   WITHDRAW
================================ */

function withdrawMoney(){

    const amount =
        Number(
            document.getElementById("withdrawAmount")
                .value
        );


    if(!amount || amount <= 0){

        showNotification(
            "Enter a valid amount."
        );

        return;
    }


    if(amount > balance){

        showNotification(
            "Insufficient local balance."
        );

        return;
    }


    balance -= amount;


    transactions.unshift({

        title:"Cash Withdrawal",

        amount:-amount,

        type:"debit",

        date:"Just now"

    });


    document.getElementById("withdrawAmount")
        .value = "";


    updateBalance();

    renderTransactions();

    openPage("homePage");

    showNotification(
        formatMoney(amount) +
        " withdrawn from local balance."
    );

}


/* ================================
   UPDATE BALANCE
================================ */

function updateBalance(){

    if(!balanceHidden){

        document.getElementById("balanceValue")
            .textContent = formatMoney(balance);

    }

}


/* ================================
   TRANSACTIONS
================================ */

function renderTransactions(){

    const recent =
        document.getElementById("recentTransactions");

    const all =
        document.getElementById("allTransactions");


    let html = "";


    transactions.forEach(transaction => {

        const sign =
            transaction.amount >= 0 ? "+" : "";

        const amountClass =
            transaction.amount >= 0
            ? "credit"
            : "debit";


        html += `

            <div class="transaction">

                <div class="transaction-left">

                    <div class="transaction-icon">
                        ${transaction.amount >= 0 ? "↓" : "↑"}
                    </div>

                    <div>

                        <div class="transaction-title">
                            ${escapeHTML(transaction.title)}
                        </div>

                        <div class="transaction-date">
                            ${escapeHTML(transaction.date)}
                        </div>

                    </div>

                </div>

                <div class="${amountClass}">
                    ${sign}${formatMoney(
                        Math.abs(transaction.amount)
                    )}
                </div>

            </div>

        `;

    });


    recent.innerHTML =
        transactions.slice(0,3)
        .map(transaction => {

            const sign =
                transaction.amount >= 0 ? "+" : "";

            const amountClass =
                transaction.amount >= 0
                ? "credit"
                : "debit";

            return `

                <div class="transaction">

                    <div class="transaction-left">

                        <div class="transaction-icon">
                            ${transaction.amount >= 0 ? "↓" : "↑"}
                        </div>

                        <div>

                            <div class="transaction-title">
                                ${escapeHTML(transaction.title)}
                            </div>

                            <div class="transaction-date">
                                ${escapeHTML(transaction.date)}
                            </div>

                        </div>

                    </div>

                    <div class="${amountClass}">
                        ${sign}${formatMoney(
                            Math.abs(transaction.amount)
                        )}
                    </div>

                </div>

            `;

        }).join("");


    all.innerHTML = html;

}


/* ================================
   MONEY FORMAT
================================ */

function formatMoney(amount){

    return "₦" +
        Number(amount).toLocaleString(
            "en-NG",
            {
                minimumFractionDigits:2,
                maximumFractionDigits:2
            }
        );

}


/* ================================
   NOTIFICATION
================================ */

function showNotification(message){

    const notification =
        document.getElementById("notification");

    notification.textContent = message;

    notification.classList.remove("hidden");


    clearTimeout(window.notificationTimer);


    window.notificationTimer =
        setTimeout(() => {

            notification.classList.add("hidden");

        },3000);

}


/* ================================
   SECURITY HELPER
================================ */

function escapeHTML(text){

    return String(text)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* ================================
   INITIAL LOAD
================================ */

renderTransactions();

</script>

